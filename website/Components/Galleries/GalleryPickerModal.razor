@using PublicCMS.Components.Utils
@inject GalleryService galleryService

<Modal Show="Show" ShowChanged="Close" Title="Galleries">
    <ModalBody>
        <GalleryList 
            Galleries="galleries"
            SelectedGallery="SelectedGallery"
            SelectedGalleryChanged="GallerySelected"
            OnCreate="CreateGallery"
            />
    </ModalBody>
</Modal>

@code {

    [Parameter]
    public bool Show { get; set; }
    [Parameter]
    public EventCallback<bool> ShowChanged { get; set; }
    [Parameter] 
    public Gallery? SelectedGallery { get; set; }
    [Parameter] 
    public EventCallback<Gallery?> SelectedGalleryChanged { get; set; }

    private List<Gallery> galleries = [];

    protected override async Task OnParametersSetAsync()
    {
        galleries = await galleryService.GetGalleriesAsync();
    }

    private async Task CreateGallery(string name)
    {
        Gallery gallery = await galleryService.CreateGalleryAsync(name);
        await GallerySelected(gallery);
    }

    private async Task Close() {
        await ShowChanged.InvokeAsync(false);
    }

    private async Task GallerySelected(Gallery? gallery)
    {
        await SelectedGalleryChanged.InvokeAsync(gallery);
        await Close();
    }
}
