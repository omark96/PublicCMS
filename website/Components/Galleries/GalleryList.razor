<div class="list-group">
@foreach (var gallery in Galleries)
{
    <button 
        class="list-group-item list-group-item-action @(gallery.Guid == SelectedGallery?.Guid ? "active" : "")"
        @onclick="() => SelectedGalleryChanged.InvokeAsync(gallery)">
        @gallery.Name
    </button>
}

<form @onsubmit="Create">
    <input class="form-text" @bind="newGalleryName" placeholder="New gallery name" />
    <button class="btn btn-primary" type="submit" disabled = "@string.IsNullOrWhiteSpace(newGalleryName)">Create</button>
</form>

</div>
@code {
    [Parameter]
    public List<Gallery> Galleries { get; set; } = [];
    [Parameter]
    public Gallery? SelectedGallery{ get; set; }
    [Parameter]
    public EventCallback<Gallery?> SelectedGalleryChanged { get; set; }
    [Parameter]
    public EventCallback<string> OnCreate { get; set; }

    string newGalleryName = "";

    async Task Create()
    {
        await OnCreate.InvokeAsync(newGalleryName.Trim());
        newGalleryName = "";
    }
}
