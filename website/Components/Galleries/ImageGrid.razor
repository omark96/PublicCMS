@inject IOptions<ApiSettings> Api
<div class="row row-cols-2" >
    @foreach (var image in Images)
    {
        <div class="col d-flex p-2 justify-content-center">
            <img class="img-fluid @(image.Guid == SelectedImage?.Guid ? "border border-primary" : "") "
            style="max-height: 150px; object-fit:contain; cursor: pointer;" 
            src="@Api.Value.ImageUrl(image.Guid)" 
            @onclick="() => SelectedImage = image"
            />
        </div>
    }
    <div class="col d-flex p-2 justify-content-center">
        <label for="files" class="d-flex align-items-center justify-content-center w-100 border rounded text-secondary" style="height: 150px; cursor: pointer;">
            <svg xmlns="http://www.w3.org/2000/svg" width="60" height="60" fill="currentColor" class="bi bi-file-earmark-plus" viewBox="0 0 16 16">
              <path d="M8 6.5a.5.5 0 0 1 .5.5v1.5H10a.5.5 0 0 1 0 1H8.5V11a.5.5 0 0 1-1 0V9.5H6a.5.5 0 0 1 0-1h1.5V7a.5.5 0 0 1 .5-.5"/>
              <path d="M14 4.5V14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V2a2 2 0 0 1 2-2h5.5zm-3 0A1.5 1.5 0 0 1 9.5 3V1H4a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V4.5z"/>
            </svg>
        </label>
        <InputFile id="files" class="d-none" OnChange="Upload" multiple accept="image/*" />
    </div>
</div>
<button class="btn btn-primary" @onclick="() => SelectedImageChanged.InvokeAsync(SelectedImage)" disabled="@(SelectedImage is null)">Select</button>
@code {
    [Parameter]
    public List<GalleryImage> Images { get; set; } = [];
    [Parameter]
    public GalleryImage? SelectedImage { get; set; }
    [Parameter]
    public EventCallback<GalleryImage?> SelectedImageChanged { get; set; }
    [Parameter] 
    public EventCallback<IReadOnlyList<IBrowserFile>> OnUpload { get; set; }

    private async Task Upload(InputFileChangeEventArgs e)
    {
        await OnUpload.InvokeAsync(e.GetMultipleFiles(maximumFileCount: 20));
    }
}
