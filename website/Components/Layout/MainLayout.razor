@inherits LayoutComponentBase
@inject SiteSectionService siteSectionService

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main class="d-flex flex-column min-vh-100">
        <div class="top-row px-4">
            @if(topbar is not null)
            {
                @((MarkupString)topbar.HTML)
            }
        </div>

        <article class="content px-4 m-auto flex-grow-1 w-100" style="max-width: 1200px;">
            @Body
        </article>
        @if(footer is not null)
        {
            <footer>
                @((MarkupString)footer.HTML)
            </footer>
        }
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code{
    private SiteSection? footer;
    private SiteSection? topbar;

    protected override async Task OnInitializedAsync()
    {
        footer = await siteSectionService.GetSiteSectionByNameAsync("footer");
        topbar = await siteSectionService.GetSiteSectionByNameAsync("topbar");
    }
}