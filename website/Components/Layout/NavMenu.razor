@implements IDisposable

@inject NavigationManager NavigationManager
@inject NavMenuService navMenuService

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">PublicCMS</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        @foreach (var item in menuItems)
        {
            switch (item.Visibility)
            {
                case NavMenuVisibility.Everyone:
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="@item.Link" Match="NavLinkMatch.All">
                            <span class="bi @item.Icon" aria-hidden="true"></span> @item.Text
                        </NavLink>
                    </div>
                    break;
                case NavMenuVisibility.AdminOnly:
                    <AuthorizeView Roles="Admin">
                        <Authorized>
                            <div class="nav-item px-3">
                                <NavLink class="nav-link" href="@item.Link" Match="NavLinkMatch.All">
                                    <span class="bi @item.Icon" aria-hidden="true"></span> @item.Text
                                </NavLink>
                            </div>
                        </Authorized>
                    </AuthorizeView>
                    break;
                case NavMenuVisibility.SignedInOnly:
                    <AuthorizeView>
                        <Authorized>
                            <div class="nav-item px-3">
                                <NavLink class="nav-link" href="@item.Link" Match="NavLinkMatch.All">
                                    <span class="bi @item.Icon" aria-hidden="true"></span> @item.Text
                                </NavLink>
                            </div>
                        </Authorized>
                    </AuthorizeView>
                    break;
                case NavMenuVisibility.GuestsOnly:
                    <AuthorizeView>
                        <NotAuthorized>
                            <div class="nav-item px-3">
                                <NavLink class="nav-link" href="@item.Link" Match="NavLinkMatch.All">
                                    <span class="bi @item.Icon" aria-hidden="true"></span> @item.Text
                                </NavLink>
                            </div>
                        </NotAuthorized>
                    </AuthorizeView>
                    break;
            }
        }
        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Account/Manage">
                        <span class="bi bi-person-fill" aria-hidden="true"></span> @context.User.Identity?.Name
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <form action="Account/Logout" method="post">
                        <AntiforgeryToken />
                        <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                        <button type="submit" class="nav-link">
                            <span class="bi bi-arrow-bar-left" aria-hidden="true"></span> Logout
                        </button>
                    </form>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Account/Register">
                        <span class="bi bi-person" aria-hidden="true"></span> Register
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Account/Login">
                        <span class="bi bi-person-badge" aria-hidden="true"></span> Login
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    private string? currentUrl;
    private List<NavMenuItem> menuItems = [];

    protected override async Task OnInitializedAsync()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
        menuItems = await navMenuService.GetMenuItemsAsync();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}

