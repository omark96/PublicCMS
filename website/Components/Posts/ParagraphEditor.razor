@* <textarea value="@Element.Content" @onchange="Update">@Element.Content</textarea> *@
<div class="paragraph-editor position-relative">
	<div class="toolbar bg-body-secondary p-2">
		<button class="btn btn-primary" onclick="document.execCommand('bold', false, null)">B</button>
		<button class="btn btn-primary" onclick="document.execCommand('italic', false, null)">I</button>
		<button class="btn btn-primary" onclick="createLink()" onmousedown="event.preventDefault()">
			<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-link-45deg" viewBox="0 0 16 16">
			  <path d="M4.715 6.542 3.343 7.914a3 3 0 1 0 4.243 4.243l1.828-1.829A3 3 0 0 0 8.586 5.5L8 6.086a1 1 0 0 0-.154.199 2 2 0 0 1 .861 3.337L6.88 11.45a2 2 0 1 1-2.83-2.83l.793-.792a4 4 0 0 1-.128-1.287z"/>
			  <path d="M6.586 4.672A3 3 0 0 0 7.414 9.5l.775-.776a2 2 0 0 1-.896-3.346L9.12 3.55a2 2 0 1 1 2.83 2.83l-.793.792c.112.42.155.855.128 1.287l1.372-1.372a3 3 0 1 0-4.243-4.243z"/>
			</svg>
		</button>
		<select class="form-select-sm w-auto" onchange="document.execCommand('fontName', false, this.value)">
			<option>Arial</option>
			<option>Times New Roman</option>
		</select>
		<select class="form-select-sm w-auto" onchange="document.execCommand('fontSize', false, this.value); this.selectedIndex = 0;">
			<option disabled selected value> Size </option>
			<option>1</option>
			<option>2</option>
			<option>3</option>
			<option>4</option>
			<option>5</option>
			<option>6</option>
			<option>7</option>
		</select>
	</div>
	<label class="form-label">
        Paragraph
    </label>
	<div class="form-control h-100 text-break" contenteditable @oncontentchange="Update">
		@((MarkupString)initial)
	</div>
</div>

@code {
	[Parameter]
	required public ParagraphElement Element { get; set; }

	private string initial = "";

	protected override void OnInitialized()
	{
		initial = Element.Content;
	}

	private async Task Update(ContentChangeEventArgs e)
	{
		Element.Content = e.Value ?? "";
		Console.WriteLine(Element.Content);
	}

	private void Test(MouseEventArgs args)
	{
		// Console.WriteLine("Test123");
	}
}
