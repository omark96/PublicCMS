@using PublicCMS.Components.Galleries
@inject IOptions<ApiSettings> Api

<div>
	@if (Element.Guid is not null)
	{
		<img src="@Api.Value.ImageUrl(Element.Guid.Value)" class="col-12" />
	}
	<button type="button" class="btn btn-primary" @onclick="() => showImageModal = true">
		Select image
	</button>

	<ImagePickerModal 
		@bind-Show="showImageModal"
		OnSelected="img => Element.Guid = img.Guid"
		/>
</div>

@code {
	[Parameter]
	required public ImageElement Element { get; set; }
	private bool showImageModal;
}
