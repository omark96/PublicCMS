@inject IOptions<ApiSettings> Api

<h1 class="post-header">@Post.Title</h1>
<p>Visitor count: @Post.VisitorCount</p>

@foreach (var element in Post.Elements)
{
    @switch(element)
    {
        case ParagraphElement p:
            {
                <div class="post-paragraph">@((MarkupString)p.Content)</div>
                break;
            }
        case ImageElement img:
            {
                <img class="post-image" src="@Api.Value.ImageUrl(img.Guid.Value)" />
                break;
            }
        case PluginElement plugin:
            {
                <PluginView Plugin="plugin" />
                break;
            }
    }
}



@code {
    [Parameter]
    public Post Post { get; set; } = default!;
}
