@page "/galleries"
@using PublicCMS.Components.Galleries
@rendermode InteractiveServer

@inject GalleryService galleryService

<h3>Galleries</h3>

<InputText @bind-Value="Name"></InputText>

<button @onclick="CreateGallery">Create gallery</button>
<br />
<button type="button" class="btn btn-primary" @onclick="() => showModal = true">
    Select gallery
</button>

<p>You have selected: @selectedGallery?.Name</p>

<GalleryPickerModal 
    @bind-Show="showModal" 
    @bind-SelectedGallery="selectedGallery" 
    Galleries="Galleries"/>

@code {
    private List<Gallery> Galleries { get; set; } = [];
    private string Name { get; set; } = "";
    private bool showModal;
    private Gallery? selectedGallery;

    protected override async Task OnInitializedAsync()
    {
        Galleries = await galleryService.GetGalleriesAsync();
    }

    private async Task CreateGallery()
    {
        await galleryService.CreateGalleryAsync(Name);
        Galleries = await galleryService.GetGalleriesAsync();
    }
}
