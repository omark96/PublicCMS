@page "/galleries"
@using PublicCMS.Components.Galleries
@rendermode InteractiveServer

@inject GalleryService galleryService

<h3>Galleries</h3>
<button type="button" class="btn btn-primary" @onclick="() => showModal = true">
    Select gallery
</button>

<p>You have selected: @selectedGallery?.Name</p>

<GalleryPickerModal 
    @bind-Show="showModal" 
    @bind-SelectedGallery="selectedGallery"
    />

<button type="button" class="btn btn-primary" @onclick="() => showImageModal = true">
    Select image
</button>

<ImagePickerModal 
    @bind-Show="showImageModal"
    OnSelected="ImageSelected" 
    />
<p>You have selected: @selectedImage?.Name</p>

@code {
    private string Name { get; set; } = "";
    private bool showModal;
    private bool showImageModal;
    private Gallery? selectedGallery;
    private GalleryImage? selectedImage;

    private void ImageSelected(GalleryImage image)
    {
        selectedImage = image;
    }
}
