@page "/posts/{Id:int}"
@page "/pages/{Slug}"
@using PublicCMS.Utils
@rendermode InteractiveServer
@inject PostService postService

@if (Post is not null)
{
    <PostView Post="Post"></PostView>
} else
{
    <p>No post found!</p>
}

@code {
    [Parameter]
    public int? Id { get; set; }
    [Parameter]
    public string? Slug { get; set; }

    private Post? Post;

    private int currentId;

    protected override async Task OnParametersSetAsync()
    {
        if(Id is not null)
        {
            Post = await postService.GetPostAsync(Id.Value);
        }
        if(Slug is not null)
        {
            Post = await postService.GetPostBySlugAsync(Slug);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Post is not null && currentId != Post.Id)
        {
            currentId = Post.Id;
            await postService.IncrementVisitorCountAsync(Post.Id);
        }
    }
}
