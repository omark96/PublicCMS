@page "/"
@rendermode InteractiveServer
@inject IOptions<ApiSettings> Api
@inject PostService postService
<PageTitle>Home</PageTitle>

<h1>Posts</h1>

@foreach(var post in Posts)
{
    <div class="mb-4">
        <a class="text-decoration-none" href="/pages/@post.Slug">
            <section class="card card-row" style="max-width: 1000px; max-height: 200px; overflow: hidden">
                <div class="row g-0">
                    <div class="col-md-4" >
                        @if (post.FeaturedImageGuid is Guid imageGuid)
                        {
                            <img src="@Api.Value.ImageUrl(imageGuid)" class="img-fluid rounded-start" style="height: 100%; object-fit: cover;"/>
                        }
                    </div>
                    <div class="col-md-8">
                        <div class="card-body">
                            <h4 class="card-title">@post.Title</h4>
                            <p class="text-body-secondary small">@post.CreatedAt.ToString("d MMM yyyy") · <span class="bi bi-eye"></span> @post.VisitorCount</p>
                            <p class="card-text">
                                @post.Summary
                            </p>
                        </div>
                    </div>
                </div>
            </section>
        </a>
    </div>
}

@code {
    private List<Post> Posts { get; set; } = [];

    protected override async Task OnInitializedAsync()
    {
        Posts = await postService.GetAllPostsAsync();
    }
}