@page "/admin/posts/create"
@page "/admin/posts/{Id:int}/edit"
@using PublicCMS.Components.Galleries
@rendermode InteractiveServer
@inject PostService postService
@inject NavigationManager Navigation
@inject IOptions<ApiSettings> Api

@attribute [Authorize(Roles = "Admin")]

<h3>@(IsEdit ? "Edit post" : "Create a new post")</h3>
<ul class="nav nav-tabs mb-2">
    <li class="nav-item">
	    <button class="nav-link @(editting ? "" : "active")" @onclick="()=>{editting = false;}">Preview</button>
    </li>
    <li class="nav-item">
	    <button class="nav-link @(editting ? "active" : "")" @onclick="()=>{editting = true;}">Edit</button>
    </li>
</ul>
<div>
</div>
@if(editting) {
<div class="mb-4">
	<label class="form-label">Title:</label>
	<input class="form-control" @bind="Post.Title" />
    @if (invalidSlug)
    {
        <span class="text-danger">Need a unique slug generated from title</span>
    }
</div>
<div class="mb-4">
    <label class="form-label">Blog post:</label>
    <input type="checkbox" @bind="Post.IsBlogPost"/>
</div>
<div>
    <h5>Featured image:</h5>
        @if(Post.FeaturedImageGuid is Guid imageGuid)
        {
            <img src="@Api.Value.ImageUrl(imageGuid)" class="col-12" style="max-height: 400px; object-fit: contain;" />
        }
        <ImagePickerModal 
		    @bind-Show="showImageModal"
		    OnSelected="img => Post.FeaturedImageGuid = img.Guid"
		/>
    <button type="button" class="btn btn-outline-primary" @onclick="() => showImageModal = true">
	    Select image
    </button>
</div>
<hr />
<div class="post-elements d-flex flex-column mb-4 gap-3">
@foreach(var (element, i) in Post.Elements.Select((item, index) => (item, index)))
{
	<div class="d-flex gap-2 border p-2" @key="element">
        <div class="flex-grow-1">
		@switch (element)
		{
			case ParagraphElement p:
			{
				<ParagraphEditor Element="p"/>
				break;
			}
			case ImageElement img:
			{
				<ImageBlock Element="img"/>
				break;
			}
            case PluginElement plugin:
                <PluginBlock Element="plugin"/>
                break;
            }
        </div>
        <div class="d-flex flex-column justify-content-center">
		    <div class="btn-group-vertical">
			    <button class="btn btn-outline-primary" @onclick="() => Move(i, i - 1)">↑</button>
			    <button class="btn btn-outline-primary" @onclick="() => Move(i, i + 1)">↓</button>
			    <button class="btn btn-outline-danger" @onclick="() => RemoveElement(i)">X</button>
		    </div>
        </div>
	</div>
}
</div>

<input class="btn btn-outline-primary" type="button" value="Add Paragraph" @onclick="AddParagraph" />
<input class="btn btn-outline-primary" type="button" value="Add Image" @onclick="AddImage" />
<input class="btn btn-outline-primary" type="button" value="Add Plugin" @onclick="AddPlugin" />
} else
{
<PostView Post="Post"></PostView>
}
<div class="d-flex justify-content-end mt-4 pb-5">
	<button class="btn btn-primary" @onclick="Submit">Save Post</button>
</div>

@code {
    [Parameter]
    public int? Id { get; set; }

    public Post Post { get; set; } = new();

    private bool IsEdit => Id is not null;
    private bool editting = true;
    private bool showImageModal;
    private bool invalidSlug;

    protected override async Task OnParametersSetAsync()
    {
        if (IsEdit)
        {
            Post = await postService.GetPostAsync(Id!.Value) ?? new();
        }
    }

    private async Task Submit()
    {
        if (!await postService.PostHasValidSlug(Post))
        {
            invalidSlug = true;
            return;
        }
        if (IsEdit)
        {
            await postService.UpdatePostAsync(Post);
        } else
        {
            await postService.CreatePostAsync(Post);
        }
        Navigation.NavigateTo("/admin/posts");
    }

    public void AddParagraph()
    {
        Post.Elements.Add(new ParagraphElement());
    }

    public void AddImage()
    {
        Post.Elements.Add(new ImageElement());
    }

    public void AddPlugin()
    {
        Post.Elements.Add(new PluginElement());
    }

    public void RemoveElement(int index)
    {
        Post.Elements.Remove(Post.Elements[index]);
        for (int i = 0; i < Post.Elements.Count; i++)
        {
            Post.Elements[i].Order = i;
        }
    }

    private void Move(int start, int target)
    {
        if (start < 0 || start >= Post.Elements.Count)
        {
            return;
        }

        if (target < 0 || target >= Post.Elements.Count)
        {
            return;
        }

        (Post.Elements[start], Post.Elements[target]) = (Post.Elements[target], Post.Elements[start]);

        for (int n = 0; n < Post.Elements.Count; n++)
        {
            Post.Elements[n].Order = n;
        }
    }
}
