@page "/admin/plugins"
@attribute [Authorize(Roles = "Admin")]
@inject PluginService pluginService
@inject IJSRuntime JS
@rendermode InteractiveServer

<h3>Plugins</h3>

<div class="mb-2">
    <label class="form-label">
        Select plugin:
    </label>
    <select class="form-select" @bind="selectedPluginDefinitionId">
        @foreach(var pluginDefinition in pluginDefinitions)
        {
            <option value="@pluginDefinition.Id">@pluginDefinition.Name</option>
        }
    </select>
</div>
<button class="btn btn-primary" @onclick="AddPluginDefinition">New plugin</button>
<hr />

@if(SelectedPluginDefinition is not null)
{
    <h4>@SelectedPluginDefinition.Name</h4>
    <div>
        <label class="form-label">
            Name:
        </label>
        <input class="form-control" @bind="@SelectedPluginDefinition.Name"></input>
    </div>
    <div>
        <label class="form-label">
            Data endpoint:
        </label>
        <input class="form-control" @bind="@SelectedPluginDefinition.DataEndpoint"></input>
    </div>
    <div>
        <label class="form-label">
            Template:
        </label>
        <textarea class="form-control" rows="8" @bind="@SelectedPluginDefinition.Template"></textarea>
    </div>
    <h5>Option sources:</h5>
    <div class="border p-2">
        @foreach(var source in SelectedPluginDefinition.OptionSources)
        {
            <div class="d-flex flex-column border mb-2 p-2 gap-3">
                <div>
                    <label class="form-label">
                        Name:
                    </label>
                    <input class="form-control" @bind="@source.Name"></input>
                </div>
                <div>
                    <label class="form-label">
                        Options endpoint:
                    </label>
                    <input class="form-control" @bind="@source.EndPoint"></input>
                </div>
                <div>
                    <label class="form-label">
                        Value field:
                    </label>
                    <input class="form-control" @bind="@source.ValueField"></input>
                </div>
                <div>
                    <label class="form-label">
                        Display name field:
                    </label>
                    <input class="form-control" @bind="@source.DisplayNameField"></input>
                </div>
                <div>
                    <button class="btn btn-outline-danger" @onclick="()=>RemoveSource(source)">Remove Source</button>
                </div>
            </div>
        }
        <button class="btn btn-outline-primary" @onclick="AddSource">Add new source</button>
    </div>
    <div class="d-flex justify-content-end mt-2 gap-3">
        <button class="btn btn-danger" @onclick="()=>RemovePluginDefinition(SelectedPluginDefinition)">Delete</button>
        <button class="btn btn-primary" @onclick="Save">Save</button>
    </div>
    
}


@code {
    private List<PluginDefinition> pluginDefinitions = [];
    private int selectedPluginDefinitionId;

    private PluginDefinition? SelectedPluginDefinition => pluginDefinitions.FirstOrDefault(t => t.Id == selectedPluginDefinitionId);

    protected override async Task OnInitializedAsync()
    {
        pluginDefinitions = await pluginService.GetPluginDefinitionsAsync();
        selectedPluginDefinitionId = pluginDefinitions.FirstOrDefault()?.Id ?? 0;
    }

    public async Task AddPluginDefinition()
    {
        PluginDefinition newPlugin = await pluginService.CreatePluginDefinitionAsync("New plugin");
        pluginDefinitions.Add(newPlugin);
        selectedPluginDefinitionId = newPlugin.Id;
    }

    public async Task RemovePluginDefinition(PluginDefinition plugin)
    {
        if (!await JS.InvokeAsync<bool>("confirm", "Are you sure you want to delete this?"))
        {
            return; 
        }
        await pluginService.RemovePluginDefinitionAsync(plugin);
        pluginDefinitions.Remove(plugin);
        selectedPluginDefinitionId = pluginDefinitions.FirstOrDefault()?.Id ?? 0;
    }

    public void AddSource()
    {
        if(SelectedPluginDefinition is not null)
        {
            SelectedPluginDefinition.OptionSources.Add(new());
        }
    }
    public async Task RemoveSource(OptionSource source)
    {
        if(SelectedPluginDefinition is not null)
        {
            SelectedPluginDefinition.OptionSources.Remove(source);
        }
    }

    private async Task Save()
    {
        await pluginService.SavePluginDefinitionAsync(SelectedPluginDefinition);
    }
}
