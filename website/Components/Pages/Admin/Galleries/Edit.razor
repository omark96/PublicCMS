@page "/admin/galleries/{Guid:guid}/edit"
@rendermode InteractiveServer
@inject IJSRuntime JS
@inject GalleryService galleryService

@attribute [Authorize(Roles = "Admin")]

<h3>Edit</h3>

@if(gallery is not null)
{
    <div class="border rounded overflow-hidden mt-4 mb-4 p-4">
        <label class="form-label">Gallery name</label>
        <input class="form-control" @bind="gallery.Name"/>
        <button class="btn btn-primary mt-4" @onclick="UpdateGallery">Update gallery</button>
    </div>
    <div class="border rounded overflow-hidden mb-4">
        <table class="table table-striped mb-0">
        <thead class="">
            <tr>
                <th>
                    Name
                </th>
                <th>
                    Guid
                </th>
            </tr>
        </thead>
            <tbody>
            @foreach(var image in gallery.Images)
            {
                <tr>
                    <td>@image.Name</td>
                    <td>@image.Guid</td>
                    <td class="d-flex gap-2">
                        <button type="button" @onclick="()=>RemoveImage(image)" class="btn btn-link p-0 text-danger">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-trash" viewBox="0 0 16 16">
                                <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z" />
                                <path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z" />
                            </svg>
                        </button>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    <div class="pb-5">
        <label for="files" class="btn btn-primary">Add Images</label>
        <InputFile id="files" class="d-none" OnChange="Upload" multiple accept="image/*" />
    </div>
}


@code {
    [Parameter]
    public Guid Guid { get; set; }

    private Gallery? gallery;

    protected async override Task OnInitializedAsync()
    {
        gallery = await galleryService.GetGalleryAsync(Guid);
    }

    private async Task UpdateGallery()
    {
        if(gallery is not null)
        {
            gallery = await galleryService.UpdateGalleryAsync(gallery);
        }
    }

    private async Task RemoveImage(GalleryImage image)
    {
        if (!await JS.InvokeAsync<bool>("confirm", "Are you sure you want to delete this?"))
        {
            return;
        }
        await galleryService.RemoveImageAsync(image.Guid);
        gallery = await galleryService.GetGalleryAsync(Guid);
    }

    private async Task Upload(InputFileChangeEventArgs e)
    {
        var uploadedImages = await galleryService.UploadImagesAsync(gallery!.Guid, e.GetMultipleFiles(maximumFileCount: 20));
        gallery.Images.AddRange(uploadedImages);
    }
}
